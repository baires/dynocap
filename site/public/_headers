# Cloudflare Pages. `*` matches across segments. HTML under /docs keeps its own type.
/docs/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Content-Type-Options: nosniff

/docs/*/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Content-Type-Options: nosniff

/docs/*/*/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Content-Type-Options: nosniff

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
