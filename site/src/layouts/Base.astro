---
import { ClientRouter } from "astro:transitions";
import { site } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/engine.css";
import "../styles/site.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
}
const {
  title,
  description = site.description,
  image = "/og.png",
  noindex = false,
  breadcrumbs = [],
} = Astro.props;
const fullTitle = title
  ? `${title} | ${site.name}`
  : `${site.name} | Local Linux sandboxes for AI coding agents on macOS`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS",
  description: site.description,
  url: site.url,
  license: site.licenseHref,
};
const breadcrumbLd = breadcrumbs.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.name,
    item: new URL(crumb.path, Astro.site ?? site.url).href,
  })),
} : undefined;
// Keep data inside its script element even if future content contains HTML.
const serializeJsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/switzer-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === "/og.png" && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
          property="og:image:alt"
          content="DynoCap capsule logo. Local Linux sandboxes for coding agents on macOS."
        />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {image === "/og.png" && (
      <meta
        name="twitter:image:alt"
        content="DynoCap capsule logo. Local Linux sandboxes for coding agents on macOS."
      />
    )}
    <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbLd)} />}
    <script is:inline>
      document.documentElement.classList.add("js");
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
        document.documentElement.classList.add("motion");
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#content">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { start } from "../engine/astro";
      import { setupMotion } from "../motion/setup";
      start(setupMotion);
    </script>
    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "a79649c98cb14a23857b465c8e9575bb"}'
      fetchpriority="low"
    ></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
