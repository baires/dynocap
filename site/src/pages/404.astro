---
import Base from "../layouts/Base.astro";
---

<Base title="Missing path" description="This path is not a DynoCap page." noindex>
  <section class="empty">
    <h1 id="content" tabindex="-1">Nothing is running here.</h1>
    <p>This path is not a command, and it is not a sandbox.</p>
    <div class="actions">
      <a class="seal-link" href="/">
        <span>Back home</span>
        <i aria-hidden="true"></i>
      </a>
      <a class="seal-link" href="/docs">
        <span>Read the docs</span>
        <i aria-hidden="true"></i>
      </a>
    </div>
  </section>
</Base>
