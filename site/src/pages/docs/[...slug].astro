---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import { docDescription, docHref, docMarkdownHref, docTitle, loadDocs, neighbors } from "../../lib/docs";

export async function getStaticPaths() {
  const { flat } = await loadDocs();
  return flat.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const { groups, flat } = await loadDocs();
const title = docTitle(entry);
const description = docDescription(entry);
const { previous, next } = neighbors(flat, entry.id);
const markdown = docMarkdownHref(entry.id);
---

<Base title={title} description={description} breadcrumbs={[
  { name: "Home", path: "/" },
  { name: "Docs", path: "/docs" },
  { name: title, path: docHref(entry.id) },
]}>
  <div class="docs-shell">
    <DocsSidebar groups={groups} current={docHref(entry.id)} />
    <article class="prose">
      <Content />
      <nav class="docs-turn" aria-label="Continue">
        {
          previous && (
            <a href={docHref(previous.id)} data-turn="previous">
              <span>Previous</span>
              {docTitle(previous)}
            </a>
          )
        }
        {
          next && (
            <a href={docHref(next.id)} data-turn="next">
              <span>Next</span>
              {docTitle(next)}
            </a>
          )
        }
      </nav>
      <p class="docs-md">
        This page is also <a href={markdown}>plain Markdown</a>, for agents and for you.
      </p>
    </article>
    <aside class="docs-outline" aria-labelledby="outline-title">
      {
        outline.length > 1 && (
          <>
            <p id="outline-title">On this page</p>
            <ol>
              {outline.map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </>
        )
      }
      <a class="docs-outline__md" href={markdown}>View as Markdown</a>
    </aside>
  </div>
</Base>
